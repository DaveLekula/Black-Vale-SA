# BLACKVALE SA — Environment Variables
# Copy this file to .env.local and fill in the values for your deployment.
# Never commit .env.local to version control.

# Public base URL (no trailing slash) — used for canonical URLs, OG images, sitemap
NEXT_PUBLIC_BASE_URL=https://blackvalesa.com

# Contact form: recipient email address
# When set, enquiries submitted via the contact form will be sent here.
# Leave empty to run in "unavailable" mode (form shows an honest message).
CONTACT_EMAIL=

# If using SendGrid for email delivery, set these:
# SENDGRID_API_KEY=
# FROM_EMAIL=noreply@blackvalesa.com
